generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String?    @unique
  emailVerified  DateTime?
  image          String?
  // 이메일 가입 시 발급한 6자리 보안키의 bcrypt 해시. 원문 보안키는 서버에 저장하지 않는다.
  securityKeyHash String?
  // 로그인 전 재발급 요청은 이메일 소유가 확인되기 전까지 데이터를 지우지 않는다.
  // 새 키로 로그인에 성공한 트랜잭션 안에서 시나리오 삭제와 함께 false로 돌아간다.
  securityKeyResetPending Boolean @default(false)
  tier           String     @default("basic")
  simulationData String?
  // 이 계정의 데이터가 보안키로 잠겨 있음을 서버가 기억하는 자리. 서버가 암호문을 처음 받거나
  // 읽은 순간 세워지고, 이후 내려가지 않는다.
  //
  // 이게 없던 시절에는 클라이언트가 "지금 받아 온 payload가 암호문이냐"만 보고 키를 요구했다.
  // 그러면 평문 행이 하나라도 생기는 순간(레거시 simulationData 마이그레이션, 키 없는 세션의
  // 저장) 그 계정은 어느 브라우저에서든 키 없이 열린다 — E2EE가 조용히 꺼진다.
  e2eeEnabledAt  DateTime?
  // 이 계정이 시뮬레이터에서 마지막으로 선택한 시나리오. 브라우저가 아니라 계정에 붙여 두어야
  // 다른 기기·브라우저에서 로그인해도 같은 시나리오로 이어진다(예전에는 localStorage에만
  // 있어서, 로그인이라는 계정 단위 사건이 브라우저를 바꾸는 순간 선택이 사라졌다).
  //
  // Scenario를 향한 관계가 아니라 평범한 문자열이다. 관계로 묶으면 User↔Scenario가 두 방향이
  // 되어 이름 붙은 relation이 필요해지는데, 이 값은 무결성을 강제할 대상이 아니다 — 가리키던
  // 행이 사라지면 클라이언트가 첫 시나리오로 되돌리고 그 값을 다시 올려 스스로 낫는다.
  lastActiveScenarioId String?
  // 대시보드에서 함께 비교하던 시나리오들. lastActiveScenarioId와 같은 이유로 계정에 붙인다 —
  // 비교 대상은 결과 화면을 바꾸는 사용자 결정이므로 브라우저를 바꿔도 따라와야 한다.
  //
  // 관계가 아니라 JSON 문자열 배열이다. 순서가 뜻을 갖고(카드가 고른 순서대로 늘어선다),
  // 가리키던 행이 사라지면 클라이언트가 목록에 없는 id를 걸러 내고 다시 올려 스스로 낫는다.
  compareScenarioIds String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scenarios      Scenario[]
}

model Scenario {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  data      String
  // 이 시나리오에서 「분석 시작」을 눌러 결과 화면을 만든 적이 있는지.
  //
  // 결과 자체는 저장하지 않는다. 시뮬레이션·Monte Carlo·추천은 전부 data에서 파생되므로,
  // 결과를 함께 저장하면 같은 계획을 말하는 출처가 둘이 되고 그중 하나는 반드시 낡는다.
  // 저장하는 것은 "다시 계산해도 되는가"라는 사실 하나뿐이고, 화면은 로그인 직후 저장된
  // data로 같은 계산을 다시 돌려 세운다.
  //
  // data와 달리 E2EE 대상이 아니다. 금액도 나이도 아닌 "이 사용자가 버튼을 눌렀다"는 사실이라
  // 암호화해서 얻을 것이 없고, 암호화하면 서버가 이 값만 갱신하는 요청을 검증할 수 없다.
  analyzedAt DateTime?
  // 분석 당시 입력을 식별하는 단방향 해시. 클라이언트가 현재 입력과 비교해 「재분석 필요」를
  // 판정하며, 서버는 저장하고 되돌려줄 뿐 이 값으로 아무것도 판정하지 않는다.
  //
  // analyzedAt과 달리 이 값은 «평문에서 유도된다». 그래서 계약이 하나 더 붙는다: 출력에서
  // 입력을 복원할 수 없어야 한다(scenarioAnalysisHash 참조 — 고정폭 단방향 해시이며 가역
  // 인코딩으로 대체해서는 안 된다). 앞의 v1은 직렬화 규칙의 버전이라, 규칙이 바뀌면 옛 값이
  // 「알 수 없음」으로 떨어져 analyzedAt만 보던 동작으로 안전하게 되돌아간다.
  analyzedParamsHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  sessionId String?
  createdAt DateTime @default(now())
}
